<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.purchasehistorysystem.controller.WelcomeAlertController"
      styleClass="alert-container" spacing="10">

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        stylesheets="@../../styles/global.css, @../../styles/alert.css"
        styleClass="alert-container" spacing="10"
        fx:controller="com.purchasehistorysystem.controller.DeleteIconAlertController">

    <Label>Ви впевнені, що хочете видалити іконку?</Label>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="cancelButton" onAction="#onCancelButton" styleClass="cancel-button">Скасувати</Button>
        <Button onAction="#onDeleteButton" styleClass="delete-button">Видалити</Button>
    </HBox>
</VBox>
